# Copy to .env (never commit .env). Create a fine-grained HF token with
# "Make calls to Inference Providers" permission only.
WATTMAGENT_HF_TOKEN=hf_xxx
WATTMAGENT_LLM_MODELS=Qwen/Qwen2.5-7B-Instruct,meta-llama/Llama-3.1-8B-Instruct
WATTMAGENT_DAILY_TOKEN_BUDGET=150000
WATTMAGENT_API_KEYS=change-me-long-random-string
