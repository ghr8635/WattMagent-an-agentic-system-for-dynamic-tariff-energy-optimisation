# Copy to .env (never commit .env). Used by deploy/compose.yaml.
# Keys: at least 16 characters each, comma-separated, long and random.
WATTMAGENT_API_KEYS=change-me-to-a-long-random-string
WATTMAGENT_PRICE_SOURCE=smard
WATTMAGENT_PRICE_REFRESH_S=900
WATTMAGENT_TIMEZONE=Europe/Berlin
WATTMAGENT_RATE_LIMIT_PER_MIN=20
WATTMAGENT_AUDIT_LOG=/home/app/data/audit.jsonl
WATTMAGENT_LANGUAGE_BACKEND=rules

# Only read when WATTMAGENT_LANGUAGE_BACKEND=llm (connected last). A fine-grained HF token
# with "Make calls to Inference Providers" permission only, or a local OpenAI-compatible
# server such as Ollama (WATTMAGENT_HF_BASE_URL=http://localhost:11434/v1).
# WATTMAGENT_HF_TOKEN=hf_xxx
# WATTMAGENT_LLM_MODELS=Qwen/Qwen2.5-7B-Instruct,meta-llama/Llama-3.1-8B-Instruct
# WATTMAGENT_DAILY_TOKEN_BUDGET=150000
